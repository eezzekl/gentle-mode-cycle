{
	"name": "@eezzekl/gentle-mode-cycle",
	"version": "0.1.0",
	"publishConfig": {
		"access": "public"
	},
	"description": "Rotate the gentle-shell session permission mode with one key (or /mode-cycle).",
	"license": "MIT",
	"author": "Ezequiel Canul",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eezzekl/gentle-mode-cycle.git"
	},
	"homepage": "https://github.com/eezzekl/gentle-mode-cycle#readme",
	"bugs": {
		"url": "https://github.com/eezzekl/gentle-mode-cycle/issues"
	},
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"gentle-shell",
		"permissions"
	],
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"files": [
		"extensions/",
		"lib/",
		"README.md"
	],
	"scripts": {
		"test": "node --test tests/*.test.ts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm test && pnpm typecheck"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.2.0",
		"@earendil-works/pi-tui": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"engines": {
		"node": "^22.19.0 || >=23.6.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.2.0",
		"@earendil-works/pi-tui": "^1.6.0",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2"
	}
}
